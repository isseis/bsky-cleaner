# Copy this file to .env in the same directory and fill in real values:
#   cp dot.env.example .env
# docker-compose.yml expands ${...} only from a file literally named .env.
BSKY_HANDLE=your-handle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BSKY_SLACK_WEBHOOK_URL_SUCCESS=https://hooks.slack.com/services/...
BSKY_SLACK_WEBHOOK_URL_FAILURE=https://hooks.slack.com/services/...
